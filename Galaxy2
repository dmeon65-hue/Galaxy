UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.F6 then
        toggleGui()
    end
    if input.KeyCode == Enum.KeyCode.Z and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        if #undoStack > 0 then
            table.insert(redoStack, CodeInput.Text)
            CodeInput.Text = table.remove(undoStack)
            updateSyntax()
        end
    end
    if input.KeyCode == Enum.KeyCode.Y and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        if #redoStack > 0 then
            table.insert(undoStack, CodeInput.Text)
            CodeInput.Text = table.remove(redoStack)
            updateSyntax()
        end
    end
    if input.KeyCode == Enum.KeyCode.S and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        SaveBtn.MouseButton1Click:Fire()
    end
    if input.KeyCode == Enum.KeyCode.F and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        searchOpen = not searchOpen
        SearchFrame.Visible = searchOpen
    end
end)

if Settings.autoIndent then
    CodeInput.FocusLost:Connect(function(enterPressed)
        if not enterPressed or not Settings.autoIndent then return end
        local text = CodeInput.Text
        local lines = string.split(text, "\n")
        if #lines < 2 then return end
        local prevLine = lines[#lines - 1] or ""
        local indent = string.match(prevLine, "^(%s*)") or ""
        if string.match(prevLine, "%s*(function|if|for|while|repeat|do|else|elseif)") then
            indent = indent .. string.rep(" ", Settings.tabSize)
        end
        if indent ~= "" then
            lines[#lines] = indent .. string.gsub(lines[#lines], "^%s*", "")
            CodeInput.Text = table.concat(lines, "\n")
            updateSyntax()
        end
    end)
end

