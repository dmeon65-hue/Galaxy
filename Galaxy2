local function rgbHex(c) return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255)) end
local function escRich(s)
    s = string.gsub(s, "&", "&amp;")
    s = string.gsub(s, "<", "&lt;")
    s = string.gsub(s, ">", "&gt;")
    s = string.gsub(s, '"', "&quot;")
    return s
end
local function cWrap(t, c) return '<font color="'..rgbHex(c)..'">'..t..'</font>' end

local function highlightCode(source)
    local r = {}
    local i, len = 1, #source
    while i <= len do
        local ch = string.sub(source, i, i)
        if ch == "-" and string.sub(source, i, i+1) == "--" then
            if string.sub(source, i, i+3) == "--[[" then
                local cl = string.find(source, "%]%]", i+4, true)
                if cl then
                    table.insert(r, cWrap(escRich(string.sub(source, i, cl+1)), TC.commentColor))
                    i = cl + 2
                else
                    table.insert(r, cWrap(escRich(string.sub(source, i)), TC.commentColor))
                    i = len + 1
                end
            else
                local nl = string.find(source, "\n", i, true)
                if nl then
                    table.insert(r, cWrap(escRich(string.sub(source, i, nl-1)), TC.commentColor))
                    i = nl
                else
                    table.insert(r, cWrap(escRich(string.sub(source, i)), TC.commentColor))
                    i = len + 1
                end
            end
        elseif ch == "[" and (string.sub(source, i, i+1) == "[[" or string.match(string.sub(source, i, i+10), "^%[=*%[")) then
            local eqCount = 0
            local j = i + 1
            while j <= len and string.sub(source, j, j) == "=" do eqCount = eqCount + 1; j = j + 1 end
            if j <= len and string.sub(source, j, j) == "[" then
                local closePattern = "]" .. string.rep("=", eqCount) .. "]"
                local cl = string.find(source, closePattern, j+1, true)
                if cl then
                    table.insert(r, cWrap(escRich(string.sub(source, i, cl + #closePattern - 1)), TC.strColor))
                    i = cl + #closePattern
                else
                    table.insert(r, cWrap(escRich(string.sub(source, i)), TC.strColor))
                    i = len + 1
                end
            else
                table.insert(r, escRich(ch))
                i = i + 1
            end
        elseif ch == '"' or ch == "'" then
            local q = ch
            local j = i + 1
            while j <= len do
                local c2 = string.sub(source, j, j)
                if c2 == "\\" then j = j + 2
                elseif c2 == q then j = j + 1; break
                elseif c2 == "\n" then break
                else j = j + 1 end
            end
            table.insert(r, cWrap(escRich(string.sub(source, i, j-1)), TC.strColor))
            i = j
        elseif ch == "`" then
            local j = i + 1
            while j <= len do
                local c2 = string.sub(source, j, j)
                if c2 == "\\" then j = j + 2
                elseif c2 == "`" then j = j + 1; break
                else j = j + 1 end
            end
            table.insert(r, cWrap(escRich(string.sub(source, i, j-1)), TC.strColor))
            i = j
        elseif string.match(ch, "%d") or (ch == "." and string.match(string.sub(source, i+1, i+1) or "", "%d")) then
            local j = i
            if string.sub(source, i, i+1) == "0x" or string.sub(source, i, i+1) == "0X" then
                j = j + 2
                while j <= len and string.match(string.sub(source, j, j), "[%da-fA-F_]") do j = j + 1 end
            elseif string.sub(source, i, i+1) == "0b" or string.sub(source, i, i+1) == "0B" then
                j = j + 2
                while j <= len and string.match(string.sub(source, j, j), "[01_]") do j = j + 1 end
            else
                while j <= len and string.match(string.sub(source, j, j), "[%d_]") do j = j + 1 end
                if j <= len and string.sub(source, j, j) == "." then
                    j = j + 1
                    while j <= len and string.match(string.sub(source, j, j), "[%d_]") do j = j + 1 end
                end
                if j <= len and string.match(string.sub(source, j, j), "[eE]") then
                    j = j + 1
                    if j <= len and string.match(string.sub(source, j, j), "[%+%-]") then j = j + 1 end
                    while j <= len and string.match(string.sub(source, j, j), "[%d_]") do j = j + 1 end
                end
            end
            table.insert(r, cWrap(escRich(string.sub(source, i, j-1)), TC.numColor))
            i = j
        elseif string.match(ch, "[%a_]") then
            local j = i
            while j <= len and string.match(string.sub(source, j, j), "[%w_]") do j = j + 1 end
            local word = string.sub(source, i, j-1)
            local afterChar = j <= len and string.sub(source, j, j) or ""
            if SyntaxDB.constants[word] then
                table.insert(r, cWrap(escRich(word), TC.boolColor))
            elseif SyntaxDB.keywords[word] then
                table.insert(r, cWrap(escRich(word), TC.kwColor))
            elseif word == "self" then
                table.insert(r, cWrap(escRich(word), TC.selfColor))
            elseif SyntaxDB.exploitGlobals[word] then
                table.insert(r, cWrap(escRich(word), TC.globalColor))
            elseif SyntaxDB.globals[word] then
                table.insert(r, cWrap(escRich(word), TC.builtinColor))
            elseif SyntaxDB.builtins[word] then
                if afterChar == "(" then
                    table.insert(r, cWrap(escRich(word), TC.funcColor))
                else
                    table.insert(r, cWrap(escRich(word), TC.builtinColor))
                end
            elseif afterChar == "(" then
                table.insert(r, cWrap(escRich(word), TC.funcColor))
            elseif afterChar == "." and SyntaxDB.libraries[word] then
                table.insert(r, cWrap(escRich(word), TC.builtinColor))
            else
                table.insert(r, escRich(word))
            end
            i = j
        elseif string.match(ch, "[%(%)%{%}%[%]]") then
            table.insert(r, cWrap(escRich(ch), TC.tableColor))
            i = i + 1
        elseif string.match(ch, "[%+%-%%%*%/%%=~<>%.#%^:;,|&!%?@]") then
            table.insert(r, cWrap(escRich(ch), TC.opColor))
            i = i + 1
        else
            table.insert(r, escRich(ch))
            i = i + 1
        end
    end
    return table.concat(r)
end

