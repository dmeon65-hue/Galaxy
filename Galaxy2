local function populateExplorer(filter)
    for _, c in ipairs(ExpScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local scripts = {}
    local visited = {}
    local function scan(parent, depth)
        if depth > 12 then return end
        pcall(function()
            for _, child in ipairs(parent:GetChildren()) do
                if not visited[child] then
                    visited[child] = true
                    if child:IsA("LocalScript") or child:IsA("ModuleScript") then
                        if expFilter == "All" or child.ClassName == expFilter then
                            table.insert(scripts, child)
                        end
                    end
                    pcall(function() scan(child, depth + 1) end)
                end
            end
        end)
    end
    scan(Player, 0)
    pcall(function()
        if getscripts then
            for _, s in ipairs(getscripts()) do
                if not visited[s] and (s:IsA("LocalScript") or s:IsA("ModuleScript")) then
                    if expFilter == "All" or s.ClassName == expFilter then
                        visited[s] = true
                        table.insert(scripts, s)
                    end
                end
            end
        end
    end)
    pcall(function()
        if getrunningscripts then
            for _, s in ipairs(getrunningscripts()) do
                if not visited[s] and (s:IsA("LocalScript") or s:IsA("ModuleScript")) then
                    if expFilter == "All" or s.ClassName == expFilter then
                        visited[s] = true
                        table.insert(scripts, s)
                    end
                end
            end
        end
    end)
    pcall(function()
        if getloadedmodules then
            for _, s in ipairs(getloadedmodules()) do
                if not visited[s] then
                    if expFilter == "All" or expFilter == "ModuleScript" then
                        visited[s] = true
                        table.insert(scripts, s)
                    end
                end
            end
        end
    end)
    pcall(function()
        if getnilinstances then
            for _, i2 in ipairs(getnilinstances()) do
                if not visited[i2] and (i2:IsA("LocalScript") or i2:IsA("ModuleScript")) then
                    if expFilter == "All" or i2.ClassName == expFilter then
                        visited[i2] = true
                        table.insert(scripts, i2)
                    end
                end
            end
        end
    end)
    filter = filter and string.lower(filter) or ""
    local count = 0
    for _, scr in ipairs(scripts) do
        local fn = scr:GetFullName()
        if filter == "" or string.find(string.lower(fn), filter, 1, true) or string.find(string.lower(scr.Name), filter, 1, true) then
            count = count + 1
            local icon = scr:IsA("LocalScript") and "📜 " or "📦 "
            local extra = ""
            pcall(function() if scr:IsA("LocalScript") and scr.Disabled then extra = " ⏸" end end)
            local running = ""
            pcall(function()
                if getrunningscripts then
                    for _, rs in ipairs(getrunningscripts()) do
                        if rs == scr then running = " ▶"; break end
                    end
                end
            end)
            local btn = inst("TextButton", {
                Size=UDim2.new(1,-6,0,24), BackgroundColor3=TC.surface,
                BackgroundTransparency=0.5, Text=icon..fn..extra..running,
                TextColor3=scr:IsA("LocalScript") and TC.accentBright or TC.builtinColor,
                TextSize=10, Font=Enum.Font.Code, TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd, AutoButtonColor=false,
                ZIndex=17, Parent=ExpScroll,
            })
            corner(btn, 4); pad(btn, 6, 6, 0, 0)
            btn.MouseButton1Click:Connect(function()
                local rel = string.gsub(fn, "^Players%."..Player.Name.."%.", "")
                PathInput.Text = rel
                activeTab = "Editor"
                for n, f in pairs(tabFrames) do f.Visible = n == "Editor" end
                for n, tb in pairs(tabButtons) do
                    TweenService:Create(tb, TweenInfo.new(0.2), {BackgroundTransparency = n == "Editor" and 0.25 or 0.7, TextColor3 = n == "Editor" and TC.textPrimary or TC.textSecondary}):Play()
                end
            end)
            btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundTransparency=0.2}):Play() end)
            btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundTransparency=0.5}):Play() end)
        end
    end
    ExpCountLabel.Text = count .. " scripts found"
end

