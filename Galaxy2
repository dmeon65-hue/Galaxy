function resolveScript(path)
    path = string.gsub(path, "^%s+", "")
    path = string.gsub(path, "%s+$", "")
    local roots = {
        {Player, path},
        {game, path},
        {game:GetService("ReplicatedStorage"), path},
        {game:GetService("ReplicatedFirst"), path},
        {game:GetService("StarterPlayer"), path},
    }
    for _, combo in ipairs(roots) do
        local root, p = combo[1], combo[2]
        local parts = string.split(p, ".")
        local current = root
        local found = true
        for _, part in ipairs(parts) do
            part = string.gsub(part, "^%s+", "")
            part = string.gsub(part, "%s+$", "")
            if part ~= "" then
                local child = current:FindFirstChild(part)
                if not child then
                    for _, c in ipairs(current:GetChildren()) do
                        if string.lower(c.Name) == string.lower(part) then child = c; break end
                    end
                end
                if not child then
                    pcall(function()
                        child = current:FindFirstChild(part, true)
                    end)
                end
                if child then current = child else found = false; break end
            end
        end
        if found and current ~= root then return current end
    end
    pcall(function()
        if getnilinstances then
            for _, i2 in ipairs(getnilinstances()) do
                if string.find(i2:GetFullName(), path, 1, true) or i2.Name == path then
                    return i2
                end
            end
        end
    end)
    pcall(function()
        if getscripts then
            for _, s in ipairs(getscripts()) do
                if string.find(s:GetFullName(), path, 1, true) or s.Name == path then
                    return s
                end
            end
        end
    end)
    return nil, "Script not found: "..path
end

local function getSource(obj)
    if not obj then return nil end
    local src
    pcall(function() if decompile then src = decompile(obj) end end)
    if src and src ~= "" and not string.find(src, "failed") then return src, "decompile" end
    pcall(function()
        if getscriptclosure and decompile then
            local cl = getscriptclosure(obj)
            if cl then src = decompile(cl) end
        end
    end)
    if src and src ~= "" then return src, "closure+decompile" end
    pcall(function()
        if obj:IsA("ModuleScript") then
            local ok, result = pcall(require, obj)
            if ok then
                src = "-- Module return value:\n-- Type: "..type(result).."\n"
                if type(result) == "table" then
                    for k, v in pairs(result) do
                        src = src.."-- ["..tostring(k).."] = "..tostring(v).." ("..type(v)..")\n"
                    end
                else
                    src = src.."-- Value: "..tostring(result)
                end
            end
        end
    end)
    if src and src ~= "" then return src, "require" end
    pcall(function()
        if getsenv then
            local env = getsenv(obj)
            if env then
                src = "-- Environment dump (getsenv):\n"
                local sorted = {}
                for k, v in pairs(env) do table.insert(sorted, {k=tostring(k), v=tostring(v), t=type(v)}) end
                table.sort(sorted, function(a,b) return a.k < b.k end)
                for _, e in ipairs(sorted) do
                    src = src..e.k.." ["..e.t.."] = "..string.sub(e.v, 1, 200).."\n"
                end
            end
        end
    end)
    if src and src ~= "" then return src, "getsenv" end
    pcall(function()
        if getscriptbytecode then
            local bc = getscriptbytecode(obj)
            if bc then src = "-- Bytecode ("..#bc.." bytes)\n-- Raw decompiler unavailable\n-- Hash: "..(getscripthash and getscripthash(obj) or "N/A") end
        end
    end)
    if src and src ~= "" then return src, "bytecode" end
    pcall(function() src = obj.Source end)
    if src then return src, "Source property" end
    return nil, nil
end

local function applySource(obj, newSrc)
    if not obj then return false, "No script" end
    pcall(function() if setscriptable then setscriptable(obj, "Source", true) end end)
    local ok = pcall(function() obj.Source = newSrc end)
    if ok then return true, "Source property" end
    local success, method = false, ""
    pcall(function()
        if setsource then setsource(obj, newSrc); success = true; method = "setsource" end
    end)
    if success then return true, method end
    pcall(function()
        if replaceclosure and getscriptclosure then
            local old = getscriptclosure(obj)
            if old then
                local new = loadstring(newSrc)
                if new then
                    replaceclosure(old, newcclosure and newcclosure(new) or new)
                    success = true; method = "replaceclosure"
                end
            end
        end
    end)
    if success then return true, method end
    pcall(function()
        if hookfunction and getscriptclosure then
            local old = getscriptclosure(obj)
            if old then
                local new = loadstring(newSrc)
                if new then
                    hookfunction(old, newcclosure and newcclosure(new) or new)
                    success = true; method = "hookfunction"
                end
            end
        end
    end)
    if success then return true, method end
    pcall(function()
        if loadstring then
            local fn, err = loadstring(newSrc)
            if fn then
                if getsenv then
                    local env = getsenv(obj)
                    if env and setfenv then
                        setfenv(fn, setmetatable(env, {__index = getfenv(0)}))
                    end
                end
                pcall(function() obj.Disabled = true end)
                task.defer(fn)
                success = true; method = "loadstring (original disabled)"
            end
        end
    end)
    if success then return true, method end
    pcall(function() if setclipboard then setclipboard(newSrc) end end)
    return false, "All methods failed. Clipboard updated if available."
end

local undoStack, redoStack = {}, {}
local maxHistory = 100

local function pushUndo()
    local t = CodeInput.Text
    if #undoStack > 0 and undoStack[#undoStack] == t then return end
    table.insert(undoStack, t)
    if #undoStack > maxHistory then table.remove(undoStack, 1) end
    redoStack = {}
end

local lastText = ""
local autoSaveTimer = 0
CodeInput:GetPropertyChangedSignal("Text"):Connect(function()
    local current = CodeInput.Text
    if current ~= lastText then
        if tick() - autoSaveTimer > 2 then
            pushUndo()
            autoSaveTimer = tick()
        end
        lastText = current
    end
end)

