end)

LoadBtn.MouseButton1Click:Connect(function()
    local path = PathInput.Text
    if path == "" then setStatus("Enter script path", TC.error); return end
    setStatus("Loading...", TC.warning)
    local obj, err = resolveScript(path)
    if not obj then setStatus(err or "Not found", TC.error); return end
    if not (obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script")) then
        setStatus("Not a script: "..obj.ClassName, TC.error); return
    end
    ScriptInfoLabel.Text = obj.ClassName.." | "..obj.Name
    local source, method = getSource(obj)
    if source then
        pushUndo()
        CodeInput.Text = source
        updateSyntax()
        setStatus("Loaded via "..tostring(method)..": "..obj.Name, TC.success)
        addConsoleLine("Loaded: "..obj:GetFullName().." via "..tostring(method), TC.success)
    else
        setStatus("Cannot retrieve source", TC.error)
    end
end)

ApplyBtn.MouseButton1Click:Connect(function()
    local path = PathInput.Text
    if path == "" then setStatus("Enter script path", TC.error); return end
    local newSrc = CodeInput.Text
    if newSrc == "" then setStatus("No code", TC.error); return end
    setStatus("Applying...", TC.warning)
    local obj, err = resolveScript(path)
    if not obj then setStatus(err or "Not found", TC.error); return end
    local ok, method = applySource(obj, newSrc)
    setStatus(ok and ("Applied via "..method) or method, ok and TC.success or TC.error)
    addConsoleLine((ok and "Applied" or "Failed")..": "..obj:GetFullName().." | "..method, ok and TC.success or TC.error)
    if ok and Settings.autoSave then
        pcall(function() if writefile then writefile("LSE_auto_"..obj.Name..".lua", newSrc) end end)
    end
end)

DecompBtn.MouseButton1Click:Connect(function()
    local path = PathInput.Text
    if path == "" then setStatus("Enter script path", TC.error); return end
    setStatus("Decompiling...", TC.warning)
    local obj, err = resolveScript(path)
    if not obj then setStatus(err or "Not found", TC.error); return end
    local source, method
    pcall(function() if decompile then source = decompile(obj); method = "decompile" end end)
    if not source then
        pcall(function()
            if getscriptclosure and decompile then
                source = decompile(getscriptclosure(obj)); method = "closure decompile"
            end
        end)
    end
    if source then
        pushUndo()
        CodeInput.Text = source
        updateSyntax()
        setStatus("Decompiled via "..tostring(method), TC.success)
    else
        setStatus("Decompiler unavailable", TC.error)
    end
end)

ExecBtn.MouseButton1Click:Connect(function()
    local code = CodeInput.Text
    if code == "" then setStatus("No code", TC.error); return end
    setStatus("Executing...", TC.warning)
    local fn, err = loadstring(code)
    if fn then
        local results = {pcall(fn)}
        local ok = table.remove(results, 1)
        if ok then
            setStatus("Executed OK", TC.success)
            addConsoleLine("Executed code block successfully", TC.success)
        else
            setStatus("Runtime: "..tostring(results[1]), TC.error)
            addConsoleLine("Runtime: "..tostring(results[1]), TC.error)
        end
    else
        setStatus("Syntax: "..tostring(err), TC.error)
        addConsoleLine("Syntax: "..tostring(err), TC.error)
    end
end)

InjectBtn.MouseButton1Click:Connect(function()
    local code = CodeInput.Text
    if code == "" then setStatus("No code to inject", TC.error); return end
    setStatus("Injecting...", TC.warning)
    local fn, err = loadstring(code)
    if fn then
        local env = {}
        pcall(function()
            if getgenv then
                env = getgenv()
            end
        end)
        if setfenv then
            pcall(function()
                setfenv(fn, setmetatable({}, {__index = function(_, k)
                    if env[k] ~= nil then return env[k] end
                    return getfenv(0)[k]
                end, __newindex = function(_, k, v)
                    env[k] = v
                end}))
            end)
        end
        local ok, result = pcall(fn)
        if ok then
            setStatus("Injected successfully", TC.success)
            addConsoleLine("Injected code into global env", TC.success)
        else
            setStatus("Inject runtime: "..tostring(result), TC.error)
        end
    else
        setStatus("Inject syntax: "..tostring(err), TC.error)
    end
end)

SaveBtn.MouseButton1Click:Connect(function()
    local src = CodeInput.Text
    if src == "" then setStatus("Nothing to save", TC.error); return end
    local saved = false
    pcall(function()
        if writefile then
            local name = "LSE_"..os.date("%Y%m%d_%H%M%S")..".lua"
            writefile(name, src)
            setStatus("Saved: "..name, TC.success)
            saved = true
        end
    end)
    if not saved then
        pcall(function()
            if setclipboard then setclipboard(src); setStatus("Copied to clipboard", TC.warning); saved = true end
        end)
    end
    if not saved then setStatus("No save API", TC.error) end
end)

ClipBtn.MouseButton1Click:Connect(function()
    local src = CodeInput.Text
    if src == "" then setStatus("Nothing to copy", TC.error); return end
    local ok = false
    pcall(function() if setclipboard then setclipboard(src); ok = true end end)
    pcall(function() if toclipboard and not ok then toclipboard(src); ok = true end end)
    setStatus(ok and "Copied!" or "Clipboard unavailable", ok and TC.success or TC.error)
end)

