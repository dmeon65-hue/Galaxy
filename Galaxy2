local function updateSyntax()
    if hlDebounce then return end
    hlDebounce = true
    task.defer(function()
        local src = CodeInput.Text
        local lineCount = 1
        for _ in string.gmatch(src, "\n") do lineCount = lineCount + 1 end
        local nums = {}
        for l = 1, lineCount do
            table.insert(nums, cWrap(tostring(l), TC.textDim))
        end
        LineNumText.Text = table.concat(nums, "\n")
        LineCountLabel.Text = "Ln " .. lineCount .. " | Ch " .. #src
        if Settings.syntaxHL and #src < 50000 then
            local ok, hl = pcall(highlightCode, src)
            HLLabel.Text = ok and hl or escRich(src)
        elseif not Settings.syntaxHL then
            HLLabel.Text = ""
        else
            HLLabel.Text = escRich(src)
        end
        hlDebounce = false
    end)
end

