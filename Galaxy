local hakuBtn
hakuBtn = createButton("Haku", "Haku [LOOP:OFF]", function()
	if not hakuLoopRunning then
		hakuLoopRunning = true
		hakuBtn.Text = "Haku [LOOP:ON]"
		hakuBtn.BackgroundColor3 = Color3.fromRGB(20, 60, 20)

		hakuLoopThread = task.spawn(function()
			while hakuLoopRunning do
				local args = {
					"Beserk",
					"Haku",
					Vector3.new(-1473.510986328125, 22.850122451782227, -22.477205276489258)
				}
				fireSkillEvent(args)
				task.wait(10)
			end
		end)
	else
		hakuLoopRunning = false
		if hakuLoopThread then
			task.cancel(hakuLoopThread)
			hakuLoopThread = nil
		end
		hakuBtn.Text = "Haku [LOOP:Off]"
		hakuBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	end
end)

