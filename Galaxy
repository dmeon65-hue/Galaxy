local function createTool(toolName, code, autoEquip)
    local existing = player.Backpack:FindFirstChild(toolName)
    if existing then existing:Destroy() end
    if player.Character and player.Character:FindFirstChild(toolName) then
        player.Character:FindFirstChild(toolName):Destroy()
    end
    local tool = Instance.new("Tool")
    tool.Name = toolName
    tool.RequiresHandle = hasHandle
    tool.CanBeDropped = canDrop
    tool.ToolTip = "TC v1.0: "..toolName
    if hasHandle then
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(1,1,3)
        handle.Color = parseColor(colorBox.Text)
        handle.Material = Enum.Material.Neon
        handle.Parent = tool
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType[meshTypes[meshIdx]]
        mesh.Scale = Vector3.new(0.5,0.5,1.2)
        mesh.Parent = handle
        local light = Instance.new("PointLight")
        light.Color = parseColor(colorBox.Text)
        light.Range = 10
        light.Brightness = 0.6
        light.Parent = handle
        local a0 = Instance.new("Attachment",handle)
        a0.Position = Vector3.new(0,0,-1.5)
        local a1 = Instance.new("Attachment",handle)
        a1.Position = Vector3.new(0,0,1.5)
        local trail = Instance.new("Trail")
        trail.Attachment0 = a0
        trail.Attachment1 = a1
        trail.Color = ColorSequence.new(parseColor(colorBox.Text))
        trail.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,1)}
        trail.Lifetime = 0.5
        trail.MinLength = 0.1
        trail.Parent = handle
    end
    tool.Parent = player.Backpack
    if autoEquip and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid:EquipTool(tool)
    end
    local execCount = 0
    tool.Activated:Connect(function()
        execCount = execCount + 1
        addConsoleLine("["..toolName.."] #"..execCount, Color3.fromRGB(175,255,175))
        local st = tick()
        local ok, err = pcall(function() local fn = loadstring(code) if fn then fn() end end)
        local elapsed = math.floor((tick()-st)*1000)
        if ok then
            addConsoleLine("["..toolName.."] OK ("..elapsed.."ms)", T().success)
        else
            addConsoleLine("["..toolName.."] ERR: "..tostring(err), T().err)
            showStatus("Error! Console", T().err)
        end
    end)
    tool.AncestryChanged:Connect(function()
        if not tool.Parent then addConsoleLine("["..toolName.."] Removed", T().warn) end
    end)
    table.insert(getgenv().ToolCreatorSettings.toolHistory, {name=toolName, time=os.date("%H:%M:%S")})
    if #getgenv().ToolCreatorSettings.toolHistory > 40 then table.remove(getgenv().ToolCreatorSettings.toolHistory, 1) end
    return tool
end

