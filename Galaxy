local function createStars()
    starsFolder:ClearAllChildren()
    if not getgenv().ToolCreatorSettings.animStars then return end
    local t = T()
    for i=1,55 do
        local s = Instance.new("Frame")
        s.Size = UDim2.new(0,math.random(1,3),0,math.random(1,3))
        s.Position = UDim2.new(math.random()/1,0,math.random()/1,0)
        s.BackgroundColor3 = i%3==0 and t.accent or (i%2==0 and t.star1 or t.star2)
        s.BackgroundTransparency = math.random()*0.4
        s.BorderSizePixel = 0
        s.ZIndex = 50
        s.Parent = starsFolder
        Instance.new("UICorner",s).CornerRadius = UDim.new(1,0)
        spawn(function()
            local sp = math.random()*2+1.2
            while s.Parent do
                TweenService:Create(s,TweenInfo.new(sp,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.9}):Play()
                wait(sp)
                TweenService:Create(s,TweenInfo.new(sp,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.05}):Play()
                wait(sp)
            end
        end)
    end
    for i=1,4 do
        local nb = Instance.new("Frame")
        nb.Size = UDim2.new(math.random()*0.22+0.12,0,math.random()*0.14+0.08,0)
        nb.Position = UDim2.new(math.random()*0.7+0.1,0,math.random()*0.7+0.1,0)
        nb.BackgroundColor3 = t.accent
        nb.BackgroundTransparency = 0.88
        nb.BorderSizePixel = 0
        nb.ZIndex = 50
        nb.Parent = starsFolder
        Instance.new("UICorner",nb).CornerRadius = UDim.new(1,0)
        spawn(function()
            while nb.Parent do
                TweenService:Create(nb,TweenInfo.new(7,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.95,Rotation=math.random(-20,20)}):Play()
                wait(7)
                TweenService:Create(nb,TweenInfo.new(7,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.82,Rotation=math.random(-20,20)}):Play()
                wait(7)
            end
        end)
    end
end
