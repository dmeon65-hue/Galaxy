    table.sort(sorted, function(a,b)
        local fa = getgenv().ToolCreatorFavorites[a] and 1 or 0
        local fb = getgenv().ToolCreatorFavorites[b] and 1 or 0
        if fa ~= fb then return fa > fb end
        return a < b
