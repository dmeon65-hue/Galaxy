local function fireSkillEvent(args)
	ReplicatedStorage:WaitForChild("Events"):WaitForChild("Skill"):FireServer(unpack(args))
end

local function fireServerRemote(args)
	ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ServerRemote"):FireServer(unpack(args))
end

local function createButton(name, displayName, callback)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(0, 85, 0, 22)
	btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	btn.BorderSizePixel = 1
	btn.BorderColor3 = Color3.fromRGB(80, 80, 120)
	btn.Text = displayName
	btn.TextColor3 = Color3.fromRGB(220, 220, 255)
	btn.TextSize = 7
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.Parent = buttonContainer

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn

	local cooldownOverlay = Instance.new("Frame")
	cooldownOverlay.Name = "CooldownOverlay"
	cooldownOverlay.Size = UDim2.new(1, 0, 1, 0)
	cooldownOverlay.Position = UDim2.new(0, 0, 0, 0)
	cooldownOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	cooldownOverlay.BackgroundTransparency = 1
	cooldownOverlay.ZIndex = 2
	cooldownOverlay.Parent = btn

	local cooldownCorner = Instance.new("UICorner")
	cooldownCorner.CornerRadius = UDim.new(0, 4)
	cooldownCorner.Parent = cooldownOverlay

	cooldowns[name] = false

	btn.MouseButton1Click:Connect(function()
		if cooldowns[name] then return end
		cooldowns[name] = true
		btn.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
		cooldownOverlay.BackgroundTransparency = 0.5

		local success, err = pcall(callback)
		if not success then
			warn("Error on " .. name .. ": " .. tostring(err))
		end

		task.delay(COOLDOWN_TIME, function()
			cooldowns[name] = false
			btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
			cooldownOverlay.BackgroundTransparency = 1
		end)
	end)

	btn.MouseButton1Down:Connect(function()
		if not cooldowns[name] then
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
		end
	end)

	btn.MouseButton1Up:Connect(function()
		if not cooldowns[name] then
			btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
		end
	end)

	return btn
end

