		if not child:IsA("Tool") then return end
		task.wait()
		for tn, myTool in pairs(ToolInstances) do
			if child ~= myTool and child.Name == tn and myTool and myTool.Parent then
				child:Destroy()
				AddLog("Dupe blocked (BP): " .. tn)
			end
		end
	end)
end

local function WatchChar()
	local char = Player.Character
	if not char then return end
	if charConn then charConn:Disconnect() end
	charConn = char.ChildAdded:Connect(function(child)
		if not child:IsA("Tool") then return end
		task.wait()
		for tn, myTool in pairs(ToolInstances) do
			if child ~= myTool and child.Name == tn and myTool and myTool.Parent then
				child:Destroy()
				AddLog("Dupe blocked (Char): " .. tn)
			end
		end
	end)
end

