local function DestroyTool(tn)
	if Connections[tn] then Connections[tn]:Disconnect(); Connections[tn] = nil end
	if ToolEvents[tn] then
		for _, c in pairs(ToolEvents[tn]) do pcall(function() c:Disconnect() end) end
		ToolEvents[tn] = nil
	end
	ToolSchedules[tn] = nil
	ToolCdConns[tn] = nil
	ToolCooldowns[tn] = nil
	ToolStats[tn] = nil
	ToolTimers[tn] = nil
	ToolConditions[tn] = nil
	ToolChains[tn] = nil
	ToolOrigNames[tn] = nil
	local bp = Player:FindFirstChild("Backpack")
	local char = Player.Character
	local myTool = ToolInstances[tn]
	if bp then
		for _, t in pairs(bp:GetChildren()) do
			if t:IsA("Tool") and (t == myTool or t.Name == tn) then t:Destroy() end
		end
	end
	if char then
		for _, t in pairs(char:GetChildren()) do
			if t:IsA("Tool") and (t == myTool or t.Name == tn) then t:Destroy() end
		end
	end
	ToolInstances[tn] = nil
	ActiveTools[tn] = nil
end

local function SpawnTool(tn, cd, code, desc, cond, chain, event)
	DestroyTool(tn)
	PurgeAllToolsByName(tn)
	local bp = Player:FindFirstChild("Backpack")
	if not bp then return end
	local cooldown = tonumber(cd) or 0
	local tool = Instance.new("Tool")
	tool.Name = tn
	tool.RequiresHandle = false
	tool.CanBeDropped = true
	tool.ToolTip = (desc and desc ~= "") and desc or (tn .. " [" .. cd .. "s]")
	tool.Parent = bp
	ToolInstances[tn] = tool
	ToolOrigNames[tn] = tn
	ToolCooldowns[tn] = false
	ToolStats[tn] = {uses = 0, lastUsed = "Never", errors = 0, created = os.date("%H:%M:%S"), totalTime = 0, streak = 0, bestStreak = 0}
	ToolConditions[tn] = cond or ""
	ToolChains[tn] = chain or ""
	toolCreationCount = toolCreationCount + 1
	PurgeDuplicates(tn, tool)
	local conn
	conn = tool.Activated:Connect(function()
		if ToolCooldowns[tn] then return end
		if cond and cond ~= "" then
			local cOk, cR = pcall(function()
				local env = setmetatable({vars = ToolVars, player = Player}, {__index = getfenv()})
				return setfenv(loadstring("return " .. cond), env)()
			end)
			if not cOk or not cR then AddLog("Cond fail: " .. tn); return end
		end
		ToolCooldowns[tn] = true
		ToolStats[tn].uses = ToolStats[tn].uses + 1
		ToolStats[tn].lastUsed = os.date("%H:%M:%S")
		ToolStats[tn].streak = ToolStats[tn].streak + 1
		if ToolStats[tn].streak > ToolStats[tn].bestStreak then ToolStats[tn].bestStreak = ToolStats[tn].streak end
		ToolTimers[tn] = {start = tick(), duration = cooldown}
		if cdOverlayEnabled then CdOverlay.Visible = true end
		local st = tick()
		local ok, err = pcall(function()
			local env = setmetatable({vars = ToolVars, player = Player, tool = tool}, {__index = getfenv()})
			setfenv(loadstring(code), env)()
		end)
		local el = tick() - st
		ToolStats[tn].totalTime = ToolStats[tn].totalTime + el
		if not ok then
			ToolStats[tn].errors = ToolStats[tn].errors + 1
			ToolStats[tn].streak = 0
			AddLog("ERR [" .. tn .. "]: " .. tostring(err))
		else
			AddLog("Use: " .. tn .. " (" .. string.format("%.3f", el) .. "s)")
		end
		table.insert(ComboTracker, 1, {name = tn, time = tick()})
		if #ComboTracker > 25 then table.remove(ComboTracker) end
		if chain and chain ~= "" then
			task.spawn(function()
				task.wait(0.1)
				for ct in chain:gmatch("[^,]+") do
					ct = ct:match("^%s*(.-)%s*$")
					if ActiveTools[ct] and ct ~= tn then
						pcall(function()
							local env = setmetatable({vars = ToolVars, player = Player}, {__index = getfenv()})
							setfenv(loadstring(ActiveTools[ct].code), env)()
						end)
						AddLog("Chain: " .. tn .. " → " .. ct)
						task.wait(0.05)
					end
				end
			end)
		end
		if cooldown > 0 then
			ToolCdConns[tn] = true
			task.spawn(function()
				local startT = tick()
				while tick() - startT < cooldown and ToolCdConns[tn] do
					local remaining = cooldown - (tick() - startT)
					local remainInt = math.ceil(remaining)
					local pct = (tick() - startT) / cooldown
					CdBar.Size = UDim2.new(math.clamp(1 - pct, 0, 1), 0, 1, 0)
					CdBar.BackgroundColor3 = Color3.fromRGB(math.floor(120 + pct * 80), math.floor(60 - pct * 40), math.floor(220 - pct * 100))
					if cdOverlayEnabled then CdLabel.Text = tn .. " " .. string.format("%.1f", remaining) .. "s" end
					local myTool2 = ToolInstances[tn]
					if myTool2 and myTool2.Parent then
						myTool2.Name = tostring(remainInt)
					end
					task.wait(0.05)
				end
				ToolCooldowns[tn] = false
				ToolTimers[tn] = nil
				ToolCdConns[tn] = nil
				local myTool3 = ToolInstances[tn]
				if myTool3 and myTool3.Parent then
					myTool3.Name = tn
				end
				if not next(ToolTimers) then CdOverlay.Visible = false end
			end)
		else
			ToolCooldowns[tn] = false
			ToolTimers[tn] = nil
			task.delay(0.4, function() if not next(ToolTimers) then CdOverlay.Visible = false end end)
		end
	end)
	Connections[tn] = conn
	if event and event ~= "" then
		ToolEvents[tn] = {}
		if event:lower():find("loop:") then
			local interval = tonumber(event:match("loop:(%d+%.?%d*)")) or 1
			ToolSchedules[tn] = true
			task.spawn(function()
				while ToolSchedules[tn] and ActiveTools[tn] do
					pcall(function()
						local env = setmetatable({vars = ToolVars, player = Player}, {__index = getfenv()})
						setfenv(loadstring(code), env)()
					end)
					task.wait(interval)
				end
			end)
		end
		if event:lower():find("heartbeat") then
			local hbC = RunService.Heartbeat:Connect(function()
				pcall(function()
					local env = setmetatable({vars = ToolVars, player = Player}, {__index = getfenv()})
					setfenv(loadstring(code), env)()
				end)
			end)
			table.insert(ToolEvents[tn], hbC)
		end
		if event:lower():find("damage") then
			task.spawn(function()
				while ActiveTools[tn] do
					local char = Player.Character
					if char then
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then
							local hp = hum.Health
							task.wait(0.1)
							if hum.Health < hp then
								pcall(function()
									local env = setmetatable({vars = ToolVars, player = Player, damage = hp - hum.Health}, {__index = getfenv()})
									setfenv(loadstring(code), env)()
								end)
							end
						else task.wait(0.5) end
					else task.wait(0.5) end
				end
			end)
		end
	end
	ActiveTools[tn] = {name = tn, cooldown = cd, code = code, desc = desc or "", condition = cond or "", chain = chain or "", event = event or ""}
	AddLog("Spawned: " .. tn)
end

