	t.Parent = TabScroll
	Instance.new("UICorner", t).CornerRadius = UDim.new(0, 4)
	TabButtons[name] = t
	t.MouseButton1Click:Connect(function()
		for _, pg in pairs(Pages) do pg.Visible = false end
		for _, c in pairs(TabScroll:GetChildren()) do
			if c:IsA("TextButton") then Tween(c, {BackgroundColor3 = Color3.fromRGB(16, 5, 36), TextColor3 = Color3.fromRGB(115, 85, 175)}, 0.1) end
		end
		Pages[name].Visible = true
		Tween(t, {BackgroundColor3 = Color3.fromRGB(48, 18, 100), TextColor3 = Color3.fromRGB(240, 220, 255)}, 0.1)
	end)
	return t
end

