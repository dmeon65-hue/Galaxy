UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local key = input.KeyCode.Name:upper()
		if Keybinds[key] and ActiveTools[Keybinds[key]] then
			local tn = Keybinds[key]; if ToolCooldowns[tn] then return end
			local a = ActiveTools[tn]; local cond = a.condition or ""
			if cond ~= "" then
				local ok, r = pcall(function() local env = setmetatable({vars = ToolVars, player = Player}, {__index = getfenv()}); return setfenv(loadstring("return " .. cond), env)() end)
				if not ok or not r then return end
			end
			ToolCooldowns[tn] = true
			if ToolStats[tn] then ToolStats[tn].uses = ToolStats[tn].uses + 1; ToolStats[tn].lastUsed = os.date("%H:%M:%S") end
			pcall(function() local env = setmetatable({vars = ToolVars, player = Player}, {__index = getfenv()}); setfenv(loadstring(a.code), env)() end)
			AddLog("Key [" .. key .. "] → " .. tn)
			local cd = tonumber(a.cooldown) or 0
			if cd > 0 then
				ToolCdConns[tn] = true
				task.spawn(function()
					local startT = tick()
					while tick() - startT < cd and ToolCdConns[tn] do
						local rem = math.ceil(cd - (tick() - startT))
						local myTool = ToolInstances[tn]
						if myTool and myTool.Parent then myTool.Name = tostring(rem) end
						task.wait(0.05)
					end
					ToolCooldowns[tn] = false
					ToolCdConns[tn] = nil
					local myTool = ToolInstances[tn]
					if myTool and myTool.Parent then myTool.Name = tn end
				end)
			else
				ToolCooldowns[tn] = false
			end
		end
	end
end)

